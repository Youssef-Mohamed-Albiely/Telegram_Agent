# ============================================================
#  WaAssist — .gitignore
# ============================================================

# --- Secrets & environment ----------------------------------
.env
*.env
.env.*
!.env.example

# --- Python --------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
site-packages/

# --- Virtual environments ------------------------------------
venv/
env/
.venv/
.env/
ENV/

# --- Testing & coverage -------------------------------------
.pytest_cache/
.coverage
htmlcov/
*.cover
coverage.xml
*.log

# --- IDEs & editors -----------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db

# --- LangSmith / LangChain cache ----------------------------
.langchain/
langchain_cache/

# --- Misc ---------------------------------------------------
*.bak
*.tmp
*.swp
tmp/
